<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:backgroundTint="@color/navy"
            android:background="@drawable/rounded_card"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Employee Pay Calculator"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/navy" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calculate your earnings in seconds."
                android:textColor="@color/text_gray"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- Work Details -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WORK DETAILS"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/navy"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_card"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hours Worked"
                android:textColor="@color/navy" />

            <EditText
                android:id="@+id/etHours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter hours worked"
                android:inputType="numberDecimal" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hourly Rate ($)"
                android:textColor="@color/navy"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/etRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter hourly rate"
                android:inputType="numberDecimal" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tax Rate (%)"
                android:textColor="@color/navy"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/etTax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter tax percentage"
                android:inputType="numberDecimal" />

            <Button
                android:id="@+id/btnCalculate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calculate Pay"
                android:backgroundTint="@color/teal"
                android:layout_marginTop="20dp" />

        </LinearLayout>

        <!-- Pay Breakdown -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PAY BREAKDOWN"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/navy"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_card"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvPay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pay: $0.00"
                android:textSize="17sp"
                android:textColor="@color/navy" />

            <TextView
                android:id="@+id/tvOvertime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Overtime Pay: $0.00"
                android:textSize="17sp"
                android:textColor="@color/navy"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Pay: $0.00"
                android:textSize="17sp"
                android:textColor="@color/navy"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tvTax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tax: $0.00"
                android:textSize="17sp"
                android:textColor="@color/navy"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tvNetPay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_result"
                android:padding="16dp"
                android:text="Total Pay - Tax: $0.00"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/teal"
                android:layout_marginTop="20dp" />

        </LinearLayout>

        <!-- About Button -->
        <Button
            android:id="@+id/btnAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About"
            android:backgroundTint="@color/navy"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>
